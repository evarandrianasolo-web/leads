# URL publique du projet Supabase (visible côté client, sans danger).
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé service_role : SECRÈTE, serveur uniquement.
# Elle contourne la RLS — ne JAMAIS la préfixer par NEXT_PUBLIC_ ni l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role
